# Copy to backend/.env (backend) and frontend/.env.local (frontend). Placeholders only.

# ---- Backend ----
APP_ENV=development                     # development | test | production
DATABASE_URL=postgresql+psycopg://pursuit:pursuit_local_only@localhost:5433/pursuit
TEST_DATABASE_URL=postgresql+psycopg://pursuit:pursuit_local_only@localhost:5433/pursuit_test
SESSION_SECRET=replace-with-64-random-hex-chars
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                     # must be true in production (HTTPS)

# AI synthesis (optional). Without it Pursuit uses labelled rule-based synthesis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Fo integration. FO_MODE=demo simulates actions (clearly labelled).
FO_MODE=demo                            # demo | live
FO_MCP_URL=https://mcp.api.wajo.ai/fo
FO_ACCESS_TOKEN=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
