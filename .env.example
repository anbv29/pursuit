# Copy to backend/.env (backend) and frontend/.env.local (frontend). Placeholders only.

# ---- Backend ----
APP_ENV=development                     # development | test | production
DATABASE_URL=postgresql+psycopg://pursuit:pursuit_local_only@localhost:5433/pursuit
TEST_DATABASE_URL=postgresql+psycopg://pursuit:pursuit_local_only@localhost:5433/pursuit_test
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                     # must be true in production (HTTPS)

# AI synthesis (optional). Without it Pursuit uses labelled rule-based synthesis.

# All research uses this free provider. Server-side; never a NEXT_PUBLIC variable.
FREE_PREVIEW_ENABLED=true              # enable after verifying free inference with your account
OPENROUTER_API_KEY=
FREE_RESEARCH_MODEL=dots-studio/dots-3-note-preview:free

# Fo integration. FO_MODE=demo simulates actions (clearly labelled).
FO_MODE=demo                            # demo | live
ACTIONS_DISABLED=false                  # emergency stop for all external actions
FO_MCP_URL=https://mcp.api.wajo.ai/fo
FO_ACCESS_TOKEN=
CONNECTION_ENCRYPTION_KEY=               # Fernet key; generate once and keep stable
PUBLIC_APP_URL=http://localhost:3000      # callback uses this origin through Next's proxy
RESEND_API_KEY=                         # optional read-only delivery verification
RESEND_WORKSPACE_ID=                    # workspace authorized to use this Resend account

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
